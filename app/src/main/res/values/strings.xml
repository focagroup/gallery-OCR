<resources>
    <string name="app_name">Gallery OCR</string>

    <!-- Welcome / permissions -->
    <string name="welcome_title">Search the text in your screenshots</string>
    <string name="welcome_body">Gallery OCR reads the text in your screenshots and images and builds a search index on this device. Allow access to your images to get started.</string>
    <string name="privacy_statement">This app has no internet permission. Android blocks every network connection for it — internet, local network and even localhost. Text recognition runs completely on your device.</string>
    <string name="grant_access">Allow access to images</string>
    <string name="permission_denied">Access to images was denied. Please allow \"Photos and videos\" (or \"Storage\") for Gallery OCR in the app settings.</string>
    <string name="open_app_settings">Open app settings</string>
    <string name="partial_access">Only some photos are accessible. Allow access to all images to index everything.</string>
    <string name="allow_all">Allow all</string>

