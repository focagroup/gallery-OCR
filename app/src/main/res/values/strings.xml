    <string name="model_cyrillic_desc">Russian, Ukrainian, Belarusian, Bulgarian, Serbian, Macedonian, …</string>
    <string name="model_korean">Korean</string>
    <string name="model_korean_desc">Hangul</string>
    <string name="section_scan_mode">Scan mode</string>
    <string name="mode_accurate">Accurate</string>
    <string name="mode_accurate_desc">Best at finding small text. Recommended.</string>
    <string name="mode_fast">Fast</string>
    <string name="mode_fast_desc">About 1.5× faster. A small model reads clear text, only unclear lines get the full model. May miss very small text.</string>
    <string name="rescan_question_title">Scan existing images again?</string>
    <string name="rescan_question_body">The new setting applies to images scanned from now on. Images that were already scanned can be scanned again with it, which takes a while.</string>
    <string name="rescan_all">Scan again</string>
    <string name="only_new_images">Only new images</string>
