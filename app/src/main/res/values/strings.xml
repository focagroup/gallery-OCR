    <!-- Folders -->
    <string name="folders_title">Folders to scan</string>
    <string name="folders_explanation">Only images in the chosen folders are scanned and shown. Results of folders you turn off are kept, so turning them on again is instant.</string>
    <string name="all_folders">All folders</string>
    <string name="all_folders_desc">Scan every image folder, including folders created later</string>
