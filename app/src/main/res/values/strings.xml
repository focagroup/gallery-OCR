    <plurals name="folder_count">
        <item quantity="one">%1$d folder</item>
        <item quantity="other">%1$d folders</item>
    </plurals>

    <!-- Settings -->
    <string name="section_folders">Folders</string>
    <string name="section_languages">Recognition languages</string>
    <string name="languages_explanation">All models are built into the app. Each extra language makes scanning a bit slower.</string>
    <string name="model_main">Latin script, Chinese and Japanese</string>
    <string name="model_main_desc">English, German, French, Spanish, Italian, Portuguese, Polish, Turkish, … plus Chinese and Japanese</string>
